; Engine configuration file.
; Sprout Tamers - Godot 4.3 (Compatibility renderer)

config_version=5

[application]

config/name="Sprout Tamers"
config/description="An original pixel-art farming and creature-taming game. Every sprite and note is made in code."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.13, 0.19, 0.12, 1)
boot_splash/show_image=false

[autoload]

D="*res://scripts/Data.gd"
G="*res://scripts/Game.gd"
Art="*res://scripts/Art.gd"
Sfx="*res://scripts/Sfx.gd"

[display]

window/size/viewport_width=400
window/size/viewport_height=260
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.13, 0.19, 0.12, 1)
